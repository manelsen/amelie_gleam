# API Keys
GEMINI_API_KEY=sua_chave_gemini_aqui
OPENROUTER_API_KEY=           # Opcional - para multi-provedor IA

# Telegram (opcional - canal direto sem bridge)
TELEGRAM_BOT_TOKEN=           # Token obtido com @BotFather
TELEGRAM_SECRET_TOKEN=        # Obrigatório apenas para webhook; vazio fecha esse endpoint (polling funciona)
TELEGRAM_ADMIN_CHAT_ID=       # Seu ID pessoal; vazio desabilita administração remota

# Gere com: openssl rand -hex 32. Mesmo segredo no bridge e no Gleam.
BRIDGE_TOKEN=                # Obrigatório; mínimo 32 caracteres aleatórios

# WhatsApp (Pairing Code — opcional, deixar vazio para QR Code)
MOBILE_NUMBER=                # Ex: 5531999990000

# Database (caminhos dentro do container, mapeados para ./db/ no host)
DB_PATH=/data/amelie.sqlite
BRIDGE_DB_PATH=/data/bridge/whatsapp.db

# Portas
PORT=4000                    # Aplicação: disponível no host em 127.0.0.1:4001
BRIDGE_PORT=8080              # Porta interna do bridge (não exposta externamente)
BRIDGE_HOST=127.0.0.1
MEDIA_TEMP_DIR=/tmp/amelie-media # Diretório privado 0700 compartilhado entre bridge e Gleam
MANUTENCAO_INTERVALO_MS=3600000  # Intervalo de manutenção e limpeza (ms, padrão: 1h)


# Downloads por yt-dlp estão desativados. Envie o arquivo de vídeo diretamente.

# WHATSMEOW_URL e GLEAM_URL são configurados automaticamente pelo entrypoint.sh
# Não é necessário definir aqui.
